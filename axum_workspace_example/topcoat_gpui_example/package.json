{
  "name": "topcoat-gpui-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bun run typecheck && bun scripts/build.ts",
    "test": "bun run typecheck && bun test tests/*.test.ts",
    "start": "cargo run -p topcoat_gpui_example",
    "test:e2e": "bun run typecheck && bun --bun playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@noble/post-quantum": "0.5.4"
  }
}
