FROM confluentinc/cp-kafka:8.4.1

ENV CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk \
    KAFKA_NODE_ID=1 \
    KAFKA_PROCESS_ROLES=broker,controller \
    KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:29093 \
    KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
    KAFKA_LISTENERS=INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:29093 \
    KAFKA_ADVERTISED_LISTENERS=INTERNAL://confluent-kafka:29092,EXTERNAL://localhost:9092 \
    KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT \
    KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL \
    KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \
    KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 \
    KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 \
    KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0 \
    KAFKA_NUM_PARTITIONS=3 \
    KAFKA_LOG_RETENTION_HOURS=1 \
    KAFKA_LOG_DIRS=/var/lib/kafka/data \
    KAFKA_HEAP_OPTS="-Xms512m -Xmx512m"

EXPOSE 9092 29092

HEALTHCHECK --interval=10s --timeout=10s --start-period=30s --retries=12 \
    CMD kafka-topics --bootstrap-server localhost:29092 --list >/dev/null 2>&1 || exit 1
